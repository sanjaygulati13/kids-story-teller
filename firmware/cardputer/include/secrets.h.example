#pragma once

// Copy this file to include/secrets.h and fill in your own values.
// include/secrets.h is gitignored — never commit it.

// 2.4 GHz WiFi (the ESP32-S3 has no 5 GHz radio).
#define WIFI_SSID "your-2g-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// Root URL of your Tellybear server, no trailing slash or path.
#define SERVER_URL "http://192.168.1.50:8090"

// The child's player code: Parent app -> Kids tab -> Copy link, then take the part after
// /play/. Keep it private — anyone with it can play that child's stories.
#define CHILD_CODE "your-childs-player-code"

// POSIX timezone for the on-screen clock and time-of-day theme. Optional (default UTC).
#define TZ_POSIX "PST8PDT,M3.2.0,M11.1.0"
