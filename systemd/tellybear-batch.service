[Unit]
Description=Tellybear evening batch (drain queued requests)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/kids-story-teller
EnvironmentFile=%h/kids-story-teller/.env
ExecStart=%h/kids-story-teller/.venv/bin/python -m tellybear.scheduler.batch
