# Tellybear configuration. Copy to .env and fill in the REQUIRED part. Never commit your real .env.
#
# Only the LLM gateway and the admin email are required. Everything else has a sensible default,
# and story/judge models, TTS engine + voice and the daily story limit can be changed any time in
# the parent app's Admin tab. Uncomment a line below only to override its default.

# ===== REQUIRED =================================================================================

# Any OpenAI-compatible endpoint, base URL ending in /v1: llama-swap, llama.cpp server, Ollama
# (http://host:11434/v1), vLLM, LM Studio, LiteLLM, or a hosted provider.
# From Docker, a gateway running on the same machine is http://host.docker.internal:<port>/v1
TB_LLM_URL=http://localhost:8080/v1
# API key for the gateway, if it needs one (sent as "Authorization: Bearer ...").
TB_LLM_API_KEY=

# The admin account. scripts/seed.py (run automatically by Docker) creates it and prints a
# generated password once — or set TB_ADMIN_PASSWORD to choose it. Co-parents are added in the app.
TB_ADMIN_EMAIL=you@example.com
# TB_ADMIN_PASSWORD=

# ===== OPTIONAL — defaults shown ================================================================

# --- Models (defaults; pick from your gateway's model list in the Admin tab) ---
# TB_LOCAL_GEN_MODEL=gemma-3-12b-it
# A different, preferably stronger model for the safety judge. Empty = same as the story model.
# TB_LOCAL_JUDGE_MODEL=
# TB_GEN_TEMPERATURE=0.95

# --- Text-to-speech (engine, voice and server URLs can all be changed in the Admin tab) ---
# chatterbox = expressive, GPU, parent voice cloning (Chatterbox-TTS-Server)
# kokoro     = light, CPU-friendly, exact IPA pronunciation (Kokoro-FastAPI; bundled in Docker)
# TB_TTS_ENGINE=chatterbox
# TB_CHATTERBOX_URL=http://localhost:8890
# TB_CHATTERBOX_VOICE=Emily.wav
# Kokoro is the fallback engine and powers pronunciation previews. Empty = not used.
# TB_KOKORO_URL=http://localhost:8880
# TB_KOKORO_VOICE=af_bella

# --- GPU sharing (when running without Docker) ---
# The worker can swap the LLM and Chatterbox on one GPU. That needs llama-swap + rocm-smi + a
# systemd --user Chatterbox service. Set false anywhere else (Docker always uses false).
# TB_GPU_HANDOFF=true
# If your models and Chatterbox fit in VRAM together, skip the swap:
# TB_GPU_CORESIDENT=false
# TB_CHATTERBOX_SERVICE=chatterbox-tts.service

# --- Notifications (ntfy) — "story waiting for review" / "story ready" pushes. Empty = off. ---
# Pick a long, unguessable topic: anyone who knows it can read your notifications.
# TB_NTFY_URL=https://ntfy.sh
# TB_NTFY_TOPIC=
# Link used in notification buttons:
# TB_PARENT_APP_URL=http://your-server:8090/parent

# --- Accounts & security ---
# TB_OPEN_SIGNUP=false          # true = anyone who can reach the app can create a family
# TB_COOKIE_SECURE=false        # true when served over HTTPS (reverse proxy / tunnel)
# TB_API_TOKEN=                 # service token for scripts (X-API-Token header); empty = off
# TB_API_DOCS=false             # true = expose /docs

# --- Schedule & story length ---
# TB_BATCH_HOUR_LOCAL=20        # local hour the nightly batch writes "tonight" stories (Docker: set TZ)
# TB_WORDS_EARLY_MIN=240
# TB_WORDS_EARLY_MAX=560
# TB_WORDS_OLDER_MIN=300
# TB_WORDS_OLDER_MAX=700

# --- Server (without Docker; Docker sets these itself) ---
# TB_API_HOST=0.0.0.0
# TB_API_PORT=8090
# TB_DATA_DIR=./data            # database, audio, voices, model caches
# TB_DB_URL=                    # empty = SQLite in TB_DATA_DIR

# --- Optional Claude model via Anthropic API (off by default) ---
# TB_ENABLE_OPUS=false
# TB_ANTHROPIC_API_KEY=
# TB_OPUS_MODEL=
